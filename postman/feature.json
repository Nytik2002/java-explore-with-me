            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\npm.test(\"Comment id is correct\", function () {\r\n    pm.expect(response.id).to.eql(Number(pm.collectionVariables.get(\"commentId\")));\r\n});\r\n\r\npm.test(\"Comment text is correct\", function () {\r\n    pm.expect(response.text).to.eql(\"Первый комментарий к событию\");\r\n});\r\n\r\npm.test(\"Comment belongs to the correct event\", function () {\r\n    pm.expect(response.eventId).to.eql(Number(pm.collectionVariables.get(\"eventId\")));\r\n});"
            ]
