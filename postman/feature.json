            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\npm.test(\"Response is an array\", function () {\r\n    pm.expect(response).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"Array contains created comment\", function () {\r\n    const commentId = Number(pm.collectionVariables.get(\"commentId\"));\r\n    const foundComment = response.find(comment => comment.id === commentId);\r\n\r\n    pm.expect(foundComment).to.not.be.undefined;\r\n});"
